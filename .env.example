# Copiar este archivo a .env.local y poner los valores reales.
# .env.local está en .gitignore: nunca se commitea.
#
# Las mismas variables van a Project Settings de Vercel.
# No llevan prefijo NEXT_PUBLIC_: Supabase se lee solo desde el servidor,
# así que ni la URL ni la key viajan al navegador.
#
# Lo que NUNCA va aquí ni en el repo es la service_role key.

SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
